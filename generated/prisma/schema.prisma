generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model armarios {
  id              Int               @id @default(autoincrement())
  name            String
  largura         Decimal?          @db.Decimal
  espessura       Decimal?          @db.Decimal
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  estoque_fieiras estoque_fieiras[]
}

model estoque_fieiras {
  id               Int            @id
  id_armario       Int?
  codigo           String?
  data_modificacao String?
  status           status_fieira?
  espessura_atual  String?
  largura_atual    String?
  utilizacao       String?
  producao         String?
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  updated_at       DateTime?      @default(now()) @db.Timestamp(6)
  armarios         armarios?      @relation(fields: [id_armario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_armario")

  @@index([id_armario], map: "idx_fieira_armario")
  @@index([codigo], map: "idx_fieira_codigo")
}

enum status_fieira {
  morta
  nova
  polida
  requisi__o @map("requisição")
  requisicao
}
